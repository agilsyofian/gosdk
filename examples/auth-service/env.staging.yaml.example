# Environment-specific override for Staging (loaded when APP_ENV=staging)
# Only specify fields you want to override from env.yaml; unmentioned fields inherit from env.yaml!

app_version: "1.0.0-staging"

# Example: override Postgres connection for staging
# storage:
#   postgres:
#     host: "postgres-staging.internal"
#     port: 5432
#     db: "example_staging"

# Example: override Kafka brokers for staging
# messaging:
#   brokers:
#     - "kafka-staging:9092"
